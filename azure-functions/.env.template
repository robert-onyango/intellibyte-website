# Azure Functions Deployment Configuration

# This file contains environment variables needed for Azure Functions deployment
# Copy this to .env and fill in your actual values

# Azure Function App Settings
FUNCTIONS_WORKER_RUNTIME=node
AzureWebJobsStorage=<your-storage-connection-string>
AzureWebJobsFeatureFlags=EnableWorkerIndexing

# Debezium Configuration
DEBEZIUM_ENDPOINT=<your-debezium-endpoint>
DEBEZIUM_API_KEY=<your-debezium-api-key>

# Azure Application Insights (optional but recommended)
APPINSIGHTS_INSTRUMENTATIONKEY=<your-app-insights-key>

# Custom Application Settings
AZURE_FUNCTIONS_ENVIRONMENT=production
WEBSITE_RUN_FROM_PACKAGE=1